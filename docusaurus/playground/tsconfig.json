{
  // Type-checks the playground bundle (npm run typecheck:playground); esbuild builds it.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node10",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "types": [],
    // the library's sources import typeorm, which is installed here, not in the repository root
    "baseUrl": "..",
    "paths": {
      "typeorm": ["node_modules/typeorm"],
      "typeorm/*": ["node_modules/typeorm/*"]
    }
  },
  "include": ["src", ".generated/*.d.ts"]
}
